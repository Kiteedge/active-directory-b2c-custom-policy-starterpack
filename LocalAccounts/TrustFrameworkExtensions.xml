<?xml version="1.0" encoding="utf-8" ?>
<TrustFrameworkPolicy 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
  xmlns="http://schemas.microsoft.com/online/cpim/schemas/2013/06" 
  PolicySchemaVersion="0.3.0.0" 
  TenantId="keapex.onmicrosoft.com" 
  PolicyId="B2C_1A_TrustFrameworkExtensions" 
  PublicPolicyUri="http://keapex.onmicrosoft.com/B2C_1A_TrustFrameworkExtensions">
  
  <BasePolicy>
    <TenantId>keapex.onmicrosoft.com</TenantId>
    <PolicyId>B2C_1A_TrustFrameworkLocalization</PolicyId>
  </BasePolicy>
  
  <BuildingBlocks>
    <ClaimsSchema> 
      <ClaimType Id="extension_ContoursUserCreated">
        <DisplayName>Contours User Created Status</DisplayName>
        <DataType>boolean</DataType>
        <UserHelpText>Indicates if the user has been created in the external system.</UserHelpText>
      </ClaimType> 
    </ClaimsSchema> 
  </BuildingBlocks>

  <ClaimsProviders>    
    <ClaimsProvider>
      <DisplayName>Azure Active Directory Customisations</DisplayName>
      <TechnicalProfiles>
        <TechnicalProfile Id="AAD-Common">
          <DisplayName>Azure Active Directory</DisplayName>
          <Protocol Name="Proprietary" Handler="Web.TPEngine.Providers.AzureActiveDirectoryProvider, Web.TPEngine, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
          <Metadata>
            <!-- Object ID of the b2c-extensions-app -->
            <Item Key="ApplicationObjectId">465a788a-16e8-4e42-969e-1dcdd66ef8a1</Item>
            <!-- Application/Client ID of the b2c-extensions-app -->
            <Item Key="ClientId">161225c4-99fc-42eb-9d9e-fcef5f5e6f30</Item>
          </Metadata>
        </TechnicalProfile>

        <TechnicalProfile Id="AAD-UserReadUsingObjectId">
          <Metadata>
            <Item Key="Operation">Read</Item>
            <Item Key="RaiseErrorIfClaimsPrincipalDoesNotExist">true</Item>
          </Metadata>
          <IncludeInSso>false</IncludeInSso>
          <InputClaims>
            <InputClaim ClaimTypeReferenceId="objectId" Required="true" />
          </InputClaims>
          <OutputClaims>
            <OutputClaim ClaimTypeReferenceId="signInNames.emailAddress" />
            <OutputClaim ClaimTypeReferenceId="displayName" />
            <OutputClaim ClaimTypeReferenceId="otherMails" />
            <OutputClaim ClaimTypeReferenceId="givenName" />
            <OutputClaim ClaimTypeReferenceId="surname" />
            <OutputClaim ClaimTypeReferenceId="email" />
          </OutputClaims>
          <OutputClaimsTransformations>
            <OutputClaimsTransformation ReferenceId="CopySignInNamesEmailToEmail" />
          </OutputClaimsTransformations>
          <IncludeTechnicalProfile ReferenceId="AAD-Common" />
        </TechnicalProfile>
      </TechnicalProfiles>
    </ClaimsProvider>

    <ClaimsProvider>
      <DisplayName>Local Account Customisations</DisplayName>
      <TechnicalProfiles>
         <TechnicalProfile Id="login-NonInteractive">
          <DisplayName>Local Account Signin</DisplayName>
          <Metadata>
            <Item Key="client_id">acd2113a-7273-42b4-bfe2-6326d0a19471</Item>
            <Item Key="IdTokenAudience">ba415fe5-e920-4ca3-9696-0beeb4423a18</Item>
          </Metadata>
          <InputClaims>
            <InputClaim ClaimTypeReferenceId="client_id" DefaultValue="acd2113a-7273-42b4-bfe2-6326d0a19471" />
            <InputClaim ClaimTypeReferenceId="resource_id" PartnerClaimType="resource" DefaultValue="ba415fe5-e920-4ca3-9696-0beeb4423a18" />
          </InputClaims>
          <OutputClaims>
            <OutputClaim ClaimTypeReferenceId="email" PartnerClaimType="signInNames.emailAddress" />
          </OutputClaims>
        </TechnicalProfile>
      </TechnicalProfiles>
    </ClaimsProvider>

    <ClaimsProvider>
      <DisplayName>Local Account Customisations</DisplayName>
      <TechnicalProfiles>
        <TechnicalProfile Id="SelfAsserted-LocalAccountSignin-Email">
          <DisplayName>Local Account Signin</DisplayName>
          <OutputClaims>
            <OutputClaim ClaimTypeReferenceId="email" PartnerClaimType="signInNames.emailAddress" />
          </OutputClaims>
        </TechnicalProfile>
      </TechnicalProfiles>
    </ClaimsProvider>

    <!--
      override base LocalAccountSignUpWithLogonEmail with additional validation step
      which creates the organisatuin, team and user vua the contours users api
      if the status is not 200, the user journey does not advance
    -->
    <ClaimsProvider>
      <DisplayName>Local Account Customizations</DisplayName>
      <TechnicalProfiles>
        <!-- Override for the Sign-Up process -->
        <TechnicalProfile Id="LocalAccountSignUpWithLogonEmail">  
          <DisplayName>Local Account Signup</DisplayName>
          <ValidationTechnicalProfiles>   
            <!-- 1. Create the user in B2C -->
            <ValidationTechnicalProfile ReferenceId="AAD-UserWriteUsingLogonEmail" />
            
            <!-- 2. Create the user in Contours (only if not already created) -->
            <ValidationTechnicalProfile ReferenceId="UsersAPI-UserCreate">
              <Preconditions>
                <Precondition Type="ClaimEquals" ExecuteActionsIf="true">
                  <Value>extension_ApiUserCreated</Value>
                  <Value>true</Value>
                  <Action>SkipThisValidationTechnicalProfile</Action>
                </Precondition>
              </Preconditions>
            </ValidationTechnicalProfile>
           
            <!-- 3. Mark the success in B2C so we don't call the API again on retry -->
            <ValidationTechnicalProfile ReferenceId="AAD-SetContoursUserCreatedFlag" />        
          </ValidationTechnicalProfiles>
        </TechnicalProfile>
         
        <!-- Update the user record in AAD with flag to indicate Contours user created -->
        <TechnicalProfile Id="AAD-SetContoursUserCreatedFlag">
          <DisplayName>UserCreated Flag Persistence</DisplayName>
          <Protocol Name="Proprietary" Handler="Web.TPEngine.Providers.AzureActiveDirectoryProvider, Web.TPEngine, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
          <Metadata>
            <Item Key="Operation">Write</Item>
            <Item Key="RaiseErrorIfClaimsPrincipalDoesNotExist">true</Item>
            <Item Key="UserMessageIfClaimsPrincipalDoesNotExist">The user account was not found.</Item>
          </Metadata>
          <PersistedClaims>
            <PersistedClaim ClaimTypeReferenceId="objectId" />
            <PersistedClaim ClaimTypeReferenceId="extension_ContoursUserCreated" DefaultValue="true" />
          </PersistedClaims>
        </TechnicalProfile>           
      </TechnicalProfiles>    
    </ClaimsProvider>

    <ClaimsProvider>
      <DisplayName>Contours User Creation</DisplayName>
      <TechnicalProfiles>
        <TechnicalProfile Id="UsersAPI-UserCreate">
          <DisplayName>Users API User Creation</DisplayName>
          <Protocol Name="Proprietary" Handler="Web.TPEngine.Providers.RestfulProvider, Web.TPEngine, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
          <Metadata>
            <Item Key="ServiceUrl">https://ngrsdb6x-4101.uks1.devtunnels.ms/azureadb2c/create</Item>
            <Item Key="AuthenticationType">None</Item>
            <Item Key="SendClaimsIn">Body</Item>
            <Item Key="AllowInsecureAuthInProduction">true</Item>
            <Item Key="RaiseErrorIfHttpStatusCodeIsNotSuccess">true</Item>
            <Item Key="DebugMode">true</Item>
            <Item Key="ContentType">application/json</Item> 
            <Item Key="UseNoCache">true</Item>
          </Metadata>
          <InputClaims>
            <InputClaim ClaimTypeReferenceId="objectId" />
            <InputClaim ClaimTypeReferenceId="email" />
            <InputClaim ClaimTypeReferenceId="givenName" />
            <InputClaim ClaimTypeReferenceId="surname" />
            <InputClaim ClaimTypeReferenceId="displayName" />
            <InputClaim ClaimTypeReferenceId="organisationName" />
          </InputClaims>
        </TechnicalProfile>
      </TechnicalProfiles>
    </ClaimsProvider>
  </ClaimsProviders>

  <ClaimsTransformations>
    <ClaimsTransformation Id="CopySignInNamesEmailToEmail" TransformationMethod="FormatString">
      <InputClaims>
        <InputClaim ClaimTypeReferenceId="signInNames.emailAddress" TransformationClaimType="inputClaim1" />
      </InputClaims>
      <InputParameters>
        <InputParameter Id="stringFormat" DataType="string" Value="{0}" />
      </InputParameters>
      <OutputClaims>
        <OutputClaim ClaimTypeReferenceId="email" TransformationClaimType="outputClaim" />
      </OutputClaims>
    </ClaimsTransformation>
  </ClaimsTransformations>

  <UserJourneys>
    <UserJourney Id="SignUpOrSignIn">
      <OrchestrationSteps>      
        <!-- Step 1: Sign-in or sign-up page -->
        <OrchestrationStep Order="1" Type="CombinedSignInAndSignUp" ContentDefinitionReferenceId="api.signuporsignin">
          <ClaimsProviderSelections>
            <ClaimsProviderSelection ValidationClaimsExchangeId="LocalAccountSigninEmailExchange" />
          </ClaimsProviderSelections>
          <ClaimsExchanges>
            <ClaimsExchange Id="LocalAccountSigninEmailExchange" TechnicalProfileReferenceId="SelfAsserted-LocalAccountSignin-Email" />
          </ClaimsExchanges>
        </OrchestrationStep>
        
        <!-- Step 2: Excecute sign-up unless 'objectId' already exists -->
        <OrchestrationStep Order="2" Type="ClaimsExchange">
          <Preconditions>
            <Precondition Type="ClaimsExist" ExecuteActionsIf="true">
              <Value>objectId</Value>
              <Action>SkipThisOrchestrationStep</Action>
            </Precondition>
          </Preconditions>
          <ClaimsExchanges>
            <ClaimsExchange Id="SignUpWithLogonEmailExchange" TechnicalProfileReferenceId="LocalAccountSignUpWithLogonEmail" />
          </ClaimsExchanges>
        </OrchestrationStep>
        
        <!-- Step 3: Retrieve additional user attributes from Azure AD B2C that may not have been included in the token so far -->
        <OrchestrationStep Order="3" Type="ClaimsExchange">
          <ClaimsExchanges>
            <ClaimsExchange Id="AADUserReadWithObjectId" TechnicalProfileReferenceId="AAD-UserReadUsingObjectId" />
          </ClaimsExchanges>
        </OrchestrationStep>

        <!-- Step 4: Issues the final token to the client -->
        <OrchestrationStep Order="4" Type="SendClaims" CpimIssuerTechnicalProfileReferenceId="JwtIssuer" />
        </OrchestrationSteps>
      
      <ClientDefinition ReferenceId="DefaultWeb" />
    </UserJourney>   
  </UserJourneys>
</TrustFrameworkPolicy>
